{
  "name": "raw-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && next dev",
    "build": "node scripts/copy-wasm.mjs && next build",
    "postinstall": "node scripts/copy-wasm.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "libraw-wasm": "1.6.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.18.3"
}
